# ------------------------------------------------------------------
# Route : Page de Contact (Design élaboré)
# ------------------------------------------------------------------
@app.route("/contact/")
def contact():
    html_content = """
    <!DOCTYPE html>
    <html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Contactez-nous</title>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
        
        <style>
            /* Reset CSS pour partir sur de bonnes bases */
            * { margin: 0; padding: 0; box-sizing: border-box; }

            body {
                font-family: 'Poppins', sans-serif;
                /* Un joli dégradé de fond */
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                color: #333;
            }

            /* La carte blanche centrale */
            .contact-container {
                background: white;
                padding: 40px;
                border-radius: 15px;
                box-shadow: 0 15px 25px rgba(0,0,0,0.2);
                width: 100%;
                max-width: 450px;
                text-align: center;
            }

            h2 {
                margin-bottom: 20px;
                color: #444;
                font-weight: 600;
            }

            p {
                margin-bottom: 30px;
                color: #777;
                font-size: 14px;
            }

            /* Style des champs de saisie */
            .form-group {
                margin-bottom: 20px;
                text-align: left;
            }

            label {
                display: block;
                margin-bottom: 5px;
                font-size: 13px;
                color: #666;
                font-weight: 500;
            }

            input, textarea {
                width: 100%;
                padding: 12px;
                border: 2px solid #eee;
                border-radius: 8px;
                font-size: 14px;
                font-family: inherit;
                transition: border-color 0.3s ease;
            }

            /* Effet quand on clique dans un champ */
            input:focus, textarea:focus {
                border-color: #667eea;
                outline: none;
            }

            textarea {
                resize: none;
                height: 100px;
            }

            /* Le bouton Envoyer */
            .btn-submit {
                background: linear-gradient(to right, #667eea, #764ba2);
                color: white;
                border: none;
                padding: 12px 20px;
                width: 100%;
                border-radius: 25px;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            }
        </style>
    </head>
    <body>

        <div class="contact-container">
            <h2>Contactez-nous</h2>
            <p>Une question ? Un projet ? Laissez-nous un message.</p>
            
            <form action="#" method="post">
                <div class="form-group">
                    <label for="nom">Nom</label>
                    <input type="text" id="nom" name="nom" placeholder="Votre nom" required>
                </div>

                <div class="form-group">
                    <label for="prenom">Prénom</label>
                    <input type="text" id="prenom" name="prenom" placeholder="Votre prénom" required>
                </div>

                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" placeholder="Écrivez votre message ici..." required></textarea>
                </div>

                <button type="submit" class="btn-submit">Envoyer le message</button>
            </form>
        </div>

    </body>
    </html>
    """
    return render_template_string(html_content)
